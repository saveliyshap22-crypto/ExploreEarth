{
  "Map": {
    "Provider": "OpenStreetMap",
    "TileCacheSizeMb": 512,
    "StartLatitude": 20.0,
    "StartLongitude": 0.0
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org/"
  },
  "AI": {
    "Mode": "Local",
    "Profile": "Balanced",
    "Backend": "Auto",
    "ModelDirectory": "%LOCALAPPDATA%\\EarthExplorer\\Models",
    "MaximumVramMb": 6400,
    "UnloadAfterMinutes": 3,
    "CloudApiKey": ""
  },
  "Privacy": {
    "ConfirmCloudUpload": true,
    "StripExifBeforeCloudUpload": true,
    "StoreHistory": false
  }
}
