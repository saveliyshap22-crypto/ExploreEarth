<Window x:Class="EarthExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        Title="ExploreEarth"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="205" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{DynamicResource AccentBrush}" CornerRadius="12">
                        <TextBlock Text="◎" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ExploreEarth" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Исследуй планету" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" MaxWidth="760" HorizontalAlignment="Stretch" Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Город, адрес, достопримечательность или координаты"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SearchCommand}"
                            Content="Найти" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,6" Margin="0,0,8,0" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#36D399" Margin="0,0,7,0" />
                            <TextBlock Text="Сеть" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="Сменить тему" Content="◐" FontSize="18" Padding="12,7" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="ИНСТРУМЕНТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                    <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,10,0" />
                            <TextBlock Text="Поиск по карте" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="★" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="Сохранённые места" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↶" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="История" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ПОИСК МЕСТА ПО ФОТО" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <StackPanel>
                            <Border Height="116" Background="#08101B" CornerRadius="9" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" />
                                    <TextBlock Text="Перетащи фото сюда"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding PhotoName}" FontWeight="SemiBold" Margin="0,10,0,4" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PhotoMetadataSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                            <Button Command="{Binding ChoosePhotoCommand}" Content="Выбрать фотографию" />
                        </StackPanel>
                    </Border>

                    <Border Background="#211B13" BorderBrush="#4B3920" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,14,0,0">
                        <TextBlock FontSize="11" Foreground="#D8B878"
                                   Text="Анализируй только изображения, на обработку которых у тебя есть право. Фото пока обрабатывается полностью локально." />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <mapsui:MapControl x:Name="EarthMap" />

            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16" Padding="12,8"
                    Background="#D9121A27" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="OpenStreetMap" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="© участники OpenStreetMap" Foreground="#AFC0D5" FontSize="10" />
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                <Button Command="{Binding ZoomInCommand}" Content="+" FontSize="22" Width="44" Height="44" Padding="0" Margin="0,0,0,6" />
                <Button Command="{Binding ZoomOutCommand}" Content="−" FontSize="22" Width="44" Height="44" Padding="0" Margin="0,0,0,6" />
                <Button Command="{Binding ShowWorldCommand}" Content="◎" FontSize="18" Width="44" Height="44" Padding="0" ToolTip="Вся Земля" />
            </StackPanel>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                    Background="#D9121A27" CornerRadius="10" Padding="12,7">
                <TextBlock Text="{Binding PointerCoordinates}" FontFamily="Consolas" FontSize="12" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="РЕЗУЛЬТАТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedResultTitle}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{Binding SelectedResultCoordinates}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,10" />
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding OpenSelectedResultCommand}"
                                    Content="Показать на карте" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedResult}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding CoordinateText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Margin="0,8,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="10" Padding="11">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CenterCoordinates}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ZoomText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="22,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding ResourceText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
