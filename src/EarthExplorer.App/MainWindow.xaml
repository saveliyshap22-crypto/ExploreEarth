<Window x:Class="EarthExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ExploreEarth"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="{DynamicResource AccentBrush}" CornerRadius="12">
                        <TextBlock Text="◎" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ExploreEarth" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="2D · 3D Земля · GeoGuessr" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="0" Grid.Column="1" MaxWidth="760" HorizontalAlignment="Stretch" Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Город, адрес, достопримечательность или координаты"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SearchCommand}"
                            Content="Найти" />
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,6" Margin="0,0,8,0" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#36D399" Margin="0,0,7,0" />
                            <TextBlock Text="Сеть" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ToggleThemeCommand}" ToolTip="Сменить тему" Content="◐" FontSize="18" Padding="12,7" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="52,0,0,0">
                    <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsMapMode}"
                            Command="{Binding ShowMapModeCommand}" Content="Карта" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsGlobeMode}"
                            Command="{Binding ShowGlobeModeCommand}" Content="3D Земля" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsMapStylesMode}"
                            Command="{Binding ShowMapStylesModeCommand}" Content="Виды карты" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsGeoGuesserMode}"
                            Command="{Binding ShowGeoGuesserModeCommand}" Content="GeoGuessr" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="{Binding IsPhotoAiMode}"
                            Command="{Binding ShowPhotoAiModeCommand}" Content="ИИ по фото" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="16">
                    <StackPanel Visibility="{Binding IsMapMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="КАРТА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                        <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Уличный просмотр" FontWeight="SemiBold" />
                                <TextBlock Text="Зажмите жёлтого человечка справа и бросьте его на карту." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Поддерживаемые координаты" FontWeight="SemiBold" />
                                <TextBlock Text="48.8584, 2.2945 или 48°51′29″N 2°17′40″E" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding ShowWorldCommand}" Content="Показать всю Землю" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsGlobeMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="3D ЗЕМЛЯ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                        <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Настоящий глобус" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Вращайте Землю мышью, приближайте колёсиком и кликайте по поверхности." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Рендер работает в WebView2 через CesiumJS. Тайлы — OpenStreetMap." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,14,4,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsMapStylesMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ВИДЫ КАРТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                        <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Стандартная" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Улицы, адреса и объекты OpenStreetMap." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,10" />
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding UseStandardMapCommand}" Content="Включить" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Топографическая" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Рельеф, высоты и тропы OpenTopoMap-R." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,10" />
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding UseTopographicMapCommand}" Content="Включить" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsGeoGuesserMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="GEOGUESSR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                        <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Подсказка" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Text="{Binding GeoGuessClue}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="1. Осмотрите уличное фото.&#x0a;2. Поставьте метку на карте.&#x0a;3. Подтвердите ответ."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="4,0,4,12" />
                        <Button Command="{Binding StartGeoGuessRoundCommand}" Content="Новый раунд" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPhotoAiMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ИИ-ПОИСК МЕСТА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                        <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Border Height="150" Background="#08101B" CornerRadius="9" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Background="#B008101B" Padding="8">
                                            <TextBlock Text="{Binding PhotoName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding PhotoMetadataSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,10" TextWrapping="Wrap" />
                                <Button Command="{Binding ChoosePhotoCommand}" Content="Выбрать фотографию" Margin="0,0,0,8" />
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding AnalyzePhotoCommand}" Content="Запустить AI-анализ" Margin="0,0,0,8" />
                                <Button Command="{Binding CancelPhotoAnalysisCommand}" Content="Отменить анализ" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <mapsui:MapControl x:Name="EarthMap"
                               Visibility="{Binding IsTwoDimensionalMapVisible, Converter={StaticResource BoolToVisibility}}"
                               AllowDrop="True"
                               DragOver="OnMapDragOver"
                               Drop="OnPegmanDrop" />

            <wv2:WebView2 x:Name="GlobeWebView"
                          Visibility="{Binding IsGlobeMode, Converter={StaticResource BoolToVisibility}}" />

            <Border Visibility="{Binding IsTwoDimensionalMapVisible, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,8"
                    Background="#D9121A27" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{Binding MapAttributionTitle}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding MapAttributionLine}" Foreground="#AFC0D5" FontSize="10" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsTwoDimensionalMapVisible, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
                <Button Command="{Binding ZoomInCommand}" Content="+" FontSize="22" Width="44" Height="44" Padding="0" Margin="0,0,0,6" />
                <Button Command="{Binding ZoomOutCommand}" Content="−" FontSize="22" Width="44" Height="44" Padding="0" Margin="0,0,0,6" />
                <Button Command="{Binding ShowWorldCommand}" Content="◎" FontSize="18" Width="44" Height="44" Padding="0" Margin="0,0,0,9" ToolTip="Вся Земля" />
                <Border x:Name="Pegman"
                        Width="44" Height="58" CornerRadius="12"
                        Background="#F7C948" BorderBrush="#FFE7A3" BorderThickness="1"
                        Cursor="Hand" ToolTip="Зажмите и перетащите на карту"
                        PreviewMouseLeftButtonDown="OnPegmanMouseDown"
                        PreviewMouseMove="OnPegmanMouseMove">
                    <TextBlock Text="●&#x0a;人" Foreground="#2B1D00" FontSize="18" FontWeight="Bold"
                               TextAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <Border Visibility="{Binding IsGeoGuesserMode, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,74,18,18"
                    Width="430" MaxHeight="330" Background="#EE08101B"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="14" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="230" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#020712" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding StreetImageUri}" Stretch="UniformToFill" />
                            <ProgressBar Height="4" VerticalAlignment="Top" IsIndeterminate="{Binding IsStreetImageLoading}" />
                            <TextBlock Text="{Binding StreetImageStatus}" Foreground="#DCE8F8" Background="#B408101B"
                                       VerticalAlignment="Bottom" Padding="10" TextWrapping="Wrap" FontSize="11" />
                        </Grid>
                    </Border>
                    <Button Grid.Row="1" Content="Открыть панораму и пройти по улице" Margin="0,9,0,0"
                            Style="{StaticResource AccentButtonStyle}" Click="OnOpenStreetViewer" />
                </Grid>
            </Border>

            <Border Visibility="{Binding IsGeoGuesserMode, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,20,20,54"
                    MaxWidth="640" Background="#E5121A27" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="{Binding GeoGuessSelectionText}" FontFamily="Consolas" FontSize="11" />
                        <TextBlock Text="{Binding GeoGuessResult}" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SubmitGeoGuessCommand}" Content="Подтвердить" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Visibility="{Binding IsMapMode, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,18,18,54"
                    Width="380" MaxHeight="260" Background="#E5121A27" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#020712" CornerRadius="9" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding StreetImageUri}" Stretch="UniformToFill" />
                            <ProgressBar Height="4" VerticalAlignment="Top" IsIndeterminate="{Binding IsStreetImageLoading}" />
                            <TextBlock Text="{Binding StreetImageStatus}" Foreground="#DCE8F8" Background="#B408101B"
                                       VerticalAlignment="Bottom" Padding="9" TextWrapping="Wrap" FontSize="10" />
                        </Grid>
                    </Border>
                    <Button Grid.Row="1" Content="Открыть интерактивную панораму" Margin="0,8,0,0" Click="OnOpenStreetViewer" />
                </Grid>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                    Background="#D9121A27" CornerRadius="10" Padding="12,7">
                <TextBlock Text="{Binding PointerCoordinates}" FontFamily="Consolas" FontSize="12" />
            </Border>

            <Grid x:Name="StreetViewerPanel" Visibility="Collapsed" Background="#E6000000" Panel.ZIndex="100">
                <Border Margin="42" Background="#08101B" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,0">
                            <TextBlock Text="Уличная панорама Panoramax" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Content="Закрыть" Click="OnCloseStreetViewer" />
                        </Grid>
                        <wv2:WebView2 x:Name="StreetWebView" Grid.Row="1" Margin="1" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Visibility="{Binding IsMapMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="РЕЗУЛЬТАТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                        <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedResultTitle}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding SelectedResultCoordinates}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,10" />
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding OpenSelectedResultCommand}" Content="Показать на карте" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedResult}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding CoordinateText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="0" Visibility="{Binding IsGlobeMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="3D РЕНДЕР" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Глобус без API-ключа" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Атмосфера, освещение, плавное приближение и реальная проекция Земли. Подробные 3D-здания можно добавить позже через лицензированный источник." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Visibility="{Binding IsMapStylesMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="О СЛОЯХ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14">
                        <TextBlock Text="Переключение заменяет базовый слой, сохраняя метки, масштаб и результаты поиска." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Visibility="{Binding IsGeoGuesserMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="РАУНД" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Фото вместо одной подсказки" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Теперь каждый раунд загружает ближайший открытый уличный снимок Panoramax. Чем ближе метка, тем ближе результат к 5000 очкам." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="#1A2B24" BorderBrush="#28513E" BorderThickness="1" CornerRadius="12" Padding="14">
                        <TextBlock Text="▲ Жёлтая — ваш выбор&#x0a;● Зелёная — правильное место" FontSize="12" Foreground="#9BE7C1" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="0" Visibility="{Binding IsPhotoAiMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ГИПОТЕЗЫ МЕСТА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,4,0,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding PhotoHypotheses}" SelectedItem="{Binding SelectedPhotoHypothesis}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding RadiusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding Evidence}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding ShowPhotoHypothesisCommand}"
                                Content="Показать выбранную гипотезу" Margin="0,10,0,10" />
                        <Expander Header="Распознанный OCR-текст">
                            <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,7,0,0" MaxHeight="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding RecognizedText}" FontFamily="Consolas" FontSize="10" />
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Margin="0,8,0,10" />
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="10" Padding="11">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CenterCoordinates}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ZoomText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="22,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding ResourceText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
